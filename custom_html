<script>
(function () {
  'use strict';

  window.dataLayer = window.dataLayer || [];

  if (window.__squarespaceContactTrackerInstalled) {
    return;
  }

  window.__squarespaceContactTrackerInstalled = true;

  function clean(value) {
    return typeof value === 'string' ? value.trim() : '';
  }

  function isTargetForm(form) {
    return Boolean(
      form &&
      form.matches('form.react-form-contents') &&
      form.querySelector('input[name="fname"]') &&
      form.querySelector('input[name="lname"]') &&
      form.querySelector('input[type="email"]') &&
      form.querySelector('.form-item.textarea textarea')
    );
  }

  function getFormData(form) {
    var firstNameField = form.querySelector('input[name="fname"]');
    var lastNameField = form.querySelector('input[name="lname"]');
    var emailField = form.querySelector('input[type="email"]');
    var messageField = form.querySelector('.form-item.textarea textarea');

    var firstName = firstNameField
      ? clean(firstNameField.value)
      : '';

    var lastName = lastNameField
      ? clean(lastNameField.value)
      : '';

    return {
      contact_first_name: firstName,
      contact_last_name: lastName,
      contact_full_name: clean(firstName + ' ' + lastName),
      contact_email: emailField
        ? clean(emailField.value).toLowerCase()
        : '',
      contact_enquiry_message: messageField
        ? clean(messageField.value)
        : ''
    };
  }

  function pushSubmission(form) {
    var data = getFormData(form);

    if (
      !data.contact_first_name ||
      !data.contact_last_name ||
      !data.contact_email ||
      !data.contact_enquiry_message
    ) {
      console.log(
        'Squarespace GTM: required values missing.',
        data
      );
      return;
    }

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.contact_email)) {
      console.log(
        'Squarespace GTM: invalid email address.'
      );
      return;
    }

    var now = Date.now();

    if (
      form.__lastGtmSubmission &&
      now - form.__lastGtmSubmission < 3000
    ) {
      return;
    }

    form.__lastGtmSubmission = now;

    window.dataLayer.push({
      event: 'squarespace_form_submit',

      form_name: 'contact_form',
      form_type: 'squarespace_react_form',

      contact_first_name: data.contact_first_name,
      contact_last_name: data.contact_last_name,
      contact_full_name: data.contact_full_name,
      contact_email: data.contact_email,
      contact_enquiry_message: data.contact_enquiry_message
    });

    console.log(
      'Squarespace GTM: contact form pushed.',
      data
    );
  }

  /*
   * Primary listener
   */
  document.addEventListener(
    'submit',
    function (event) {
      var form = event.target;

      if (!isTargetForm(form)) {
        return;
      }

      pushSubmission(form);
    },
    true
  );

  /*
   * Squarespace/React fallback
   */
  document.addEventListener(
    'click',
    function (event) {
      var button = event.target.closest(
        'form.react-form-contents button[type="submit"]'
      );

      if (!button) {
        return;
      }

      var form = button.closest('form');

      if (!isTargetForm(form)) {
        return;
      }

      /*
       * Allow Squarespace validation to happen first.
       */
      setTimeout(function () {
        if (form.checkValidity && !form.checkValidity()) {
          console.log(
            'Squarespace GTM: browser validation failed.'
          );
          return;
        }

        pushSubmission(form);
      }, 100);
    },
    true
  );

  console.log(
    'Squarespace GTM: contact form listener installed.'
  );

})();
</script>
